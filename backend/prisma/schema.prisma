// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  username String  @unique
  // Stores hashed password
  password String  
  nickname String  @default("Anonymous User")
  bio      String?
  lastUpdatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  favouritedManga Manga[]
  userMangaPreferences UserMangaPreference[]

  // To login we will search for user with username and match hashed passwords
  @@index([username])
}

enum ReleaseStatus {
  Completed
  Ongoing
}

model Manga {
  id     String @id @default(uuid())
  title   String
  author String
  description String

  releaseStatus ReleaseStatus
  lastReleasedChapter Int
  lastReleasedVolume Int
  lastSeriesUpdateDate DateTime

  // This is the last time the series record in database was updated
  lastUpdatedAt DateTime @updatedAt

  favouritedBy User[]
  userMangaPreferences UserMangaPreference[]
}

// On the frontend also allow a none option
enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum MangaTierListRank {
  GodTier
  S
  A
  B 
  C 
  D 
  F 
  Dropped
  Unranked
}

model UserMangaPreference {
  id      String @id @default(uuid())
  // The User can add the link where they access the manga here
  mangaAccessLink String? 
  // User's can specify whether they want to be notified on the day a new chapter releases
  sendNotifications Boolean @default(false)
  // This only works for manhwa's since manhwa's usually release weekly on a consistent schedule
  // We allow the user to specify the release date because different platforms may release on different days
  mangaReleaseDay DayOfWeek?
  tierListRank MangaTierListRank @default(Unranked)
  lastUpdatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id])
  userId  String
  manga   Manga  @relation(fields: [mangaId], references: [id])
  mangaId String

  // Each user can have only one preference setting for a particular manga
  @@unique([userId, mangaId])
}
